{
  "name": "edupulse-backend",
  "version": "2.0.0",
  "description": "Backend API for the EduPulse LMS frontend (Node.js + Express + MySQL, matching schema.sql exactly)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node src/seed/migrate.js",
    "migrate:v2": "node src/seed/migrate.js --v2-only",
    "seed": "node src/seed/seed.js",
    "seed:destroy": "node src/seed/seed.js --destroy"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
