PORT=5000
NODE_ENV=development

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=edupulse

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
RESET_TOKEN_SECRET=change_this_too_a_different_long_random_string
RESET_TOKEN_EXPIRES_IN=30m

# CORS - the origin your Vite frontend runs on
CLIENT_URL=http://localhost:5173
